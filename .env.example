# ─────────────────────────── Telegram ───────────────────────────
# Токен у @BotFather. ADMIN_ID — твой числовой id (@userinfobot):
# без него в панель управления будет не войти.
BOT_TOKEN=123456:ABC...
ADMIN_ID=

# https-адрес Mini App. Локально: cloudflared tunnel --url http://localhost:8080
# Без него кнопка «Открыть Оракула» в боте не появится.
WEBAPP_URL=
DOMAIN=localhost
HTTP_PORT=8080
HTTPS_PORT=8443

# ───────────── observability (Grafana/Loki/Prometheus) ───────────
# Grafana is bound to localhost by default; use an SSH tunnel on a VPS.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Required: set a unique random password before starting Compose.
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d

# Compose database identity. A password is deliberately required; do not use a
# shared/default credential. Set POSTGRES_PASSWORD before starting Compose.
POSTGRES_DB=oracle
POSTGRES_USER=oracle
POSTGRES_PASSWORD=

# ─────────────────────────── LLM ────────────────────────────────
# auto — цепочка отказоустойчивости custom → anthropic → openai,
# затем офлайн-режим. Можно зафиксировать один: custom|anthropic|openai|off
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Любой OpenAI-совместимый сервер: vLLM, LM Studio, Ollama serve, прокси
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_MODEL_LITE=

# Модели по уровням: main — ответы клиентке, lite — фон (память, прогнозы)
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_LITE=claude-haiku-4-5
OPENAI_MODEL_MAIN=gpt-5
OPENAI_MODEL_LITE=gpt-5-mini

# ─────────────── palm vision evidence helper (optional) ─────────
# ONNX model adds auxiliary heart/head/life line segmentation evidence.
# It never replaces Mira's multimodal interpretation or photo guidance.
ORACLEAI_PALM_LINE_ENABLED=1
# Empty uses models/palm_line_student_fp16.onnx; int8 is smaller/faster but lossier.
ORACLEAI_PALM_LINE_MODEL=
# Optional MediaPipe Hand Landmarker .task asset for 21-point hand geometry.
ORACLEAI_MEDIAPIPE_MODEL=

# ──────────────────── память по смыслу (необязательно) ──────────
# Без эмбеддингов память ищется по словам — продукт работает, но хуже
# вспоминает к месту. EMBED_VIA_CUSTOM=1 — считать на своём сервере.
EMBED_MODEL=text-embedding-3-small
EMBED_VIA_CUSTOM=0

# ──────────────── озвучка прогнозов (тариф «Консьерж») ──────────
# Нужен ключ OpenAI. Без него тариф деградирует до текста, не до ошибки.
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=shimmer

# ─────────────── каналы-спутники с гороскопами ──────────────────
# По каналу на знак: код_знака:@канал через запятую. Автопостинг
# дополнительно включается флагом horoscope_channels в админке.
# HOROSCOPE_CHANNELS=aries:@oracle_aries,taurus:@oracle_taurus
HOROSCOPE_CHANNELS=

# ──────────── web-оплата подписки (Paddle / LemonSqueezy) ───────
# Комиссия 3-5% против ~30-40% у Telegram Stars — основной чек идёт сюда.
# Вебхук: https://твой-домен/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
PADDLE_API_URL=https://api.paddle.com
PADDLE_CHECKOUT_URL=
# Server-side map; example: vip:pri_...,basic:pri_...
PADDLE_PRICE_IDS=

# ───────────────────────── окружение ────────────────────────────
APP_ENV=dev
# DEV_MODE=1 пускает в API по ?dev_user=<id> с заголовком X-Dev-Key вместо
# подписи Telegram. На боевом сервере обязательно 0. При APP_ENV, отличном от
# dev|test, ИЛИ при пустом DEV_KEY процесс с DEV_MODE=1 падает ещё при импорте
# конфигурации (fail-closed, аудит SEC-001, BUS-90).
DEV_MODE=0
# Подписанный ключ dev-входа. Обязателен при DEV_MODE=1 (BUS-90): пустой ключ
# при включённом DEV_MODE роняет импорт конфигурации. ?dev_user=<id> работает
# только с заголовком X-Dev-Key. Монтируется только в локальный docker-compose.
DEV_KEY=
# Возрастная проверка удалена (GAUNTLET v2) — переменные AGE_PROOF_SALT больше не нужны.
LOG_LEVEL=INFO
LLM_MAX_CONCURRENCY=8
LLM_RATE_PER_MIN=240
LLM_WORKFLOW_TIMEOUT=90
LLM_MAX_TOOL_CALLS=12
LLM_MAX_COST_USD=0.25
DATA_DIR=
# Required for the PostgreSQL-only runtime; set it before starting Compose.
# Example: postgresql+asyncpg://oracle:password@postgres:5432/oracle
DATABASE_URL=
PGVECTOR_ENABLED=1
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=10
PG_POOL_TIMEOUT=30
PG_POOL_RECYCLE=1800
PUBLIC_URL=

# Celery background jobs; enabled because Redis and worker/beat are in Compose.
REDIS_URL=redis://redis:6379/0
CELERY_ENABLED=1
CELERY_TASK_ALWAYS_EAGER=0
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=270
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_WORKER_PREFETCH=1
CELERY_MAX_RETRIES=3

# ──────────────── продуктовые значения по умолчанию ─────────────
# Рабочие значения живут в БД и правятся в админке; эти нужны на первом старте.
TRIAL_DAYS=30
TRIAL_CRYSTALS=30

# Optional encrypted PostgreSQL backup profile.
BACKUP_ENCRYPTION_KEY_HOST_PATH=/etc/oracle/backup.key
BACKUP_STORAGE_PATH=./backups
BACKUP_REQUIRE_ENCRYPTION=1
BACKUP_REQUIRE_OFFSITE=0
BACKUP_KEEP=14
BACKUP_S3_PREFIX=oracleai

# Optional local Ollama profile. Enable with --profile local-llm.
OLLAMA_MODEL=qwen3:8b
