{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oracleai.local/schemas/palm-reviewer-registry-v1.json",
  "title": "OracleAI Palm Reviewer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "reviewers"],
  "properties": {
    "registry_version": {"type": "string", "const": "palm-reviewers-v1"},
    "reviewers": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["reviewer_id", "roles", "expertise_domains", "active", "independence", "conflict_of_interest", "attestation"],
        "properties": {
          "reviewer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["annotator", "domain_reviewer", "safety_reviewer"]}},
          "expertise_domains": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
          "qualification_reference": {"type": "string", "minLength": 3},
          "active": {"type": "boolean"},
          "independence": {"type": "string", "enum": ["independent", "conflict_disclosed", "not_eligible"]},
          "conflict_of_interest": {"type": "string", "enum": ["none", "disclosed", "not_eligible"]},
          "attestation": {
            "type": "object", "additionalProperties": false,
                          "required": ["policy_version", "accepted_at", "signed", "blinded_review", "training_reference"],

            "properties": {
              "policy_version": {"type": "string", "const": "palm-human-review-v1"},
              "accepted_at": {"type": "string", "minLength": 10},
              "signed": {"type": "boolean"},
              "blinded_review": {"type": "boolean"},
              "training_reference": {"type": "string", "minLength": 3}
            }
          }
        }
      }
    }
  }
}
