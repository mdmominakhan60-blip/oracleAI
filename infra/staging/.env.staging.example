# Шаблон env для staging-стека oracleAI. Скопировать в infra/staging/.env.staging:
#   cp infra/staging/.env.staging.example infra/staging/.env.staging
# затем заполнить значения. .env.staging в .gitignore — секреты не коммитятся.
#
# ЖЁСТКОЕ ПРАВИЛО ИЗОЛЯЦИИ: продовые значения (токен прод-бота, продовые LLM-ключи,
# продовые платёжные секреты) сюда переносить ЗАПРЕЩЕНО. Staging-бот — отдельный
# бот от @BotFather (или тестовый токен). Проверка: scripts/check_staging_isolation.sh

# ── compose-идентичность ──
COMPOSE_PROJECT_NAME=oracleai-staging

# ── staging-домен и порты ──
# Домен не должен совпадать с продовым. Для локальной репетиции сойдёт localhost —
# Caddy отдаст самоподписанный сертификат (tls internal).
STAGING_DOMAIN=localhost
STAGING_HTTPS_PORT=3443
STAGING_HTTP_PORT=3080

# ── PostgreSQL staging (отдельная БД, отдельный пароль, НЕ продовый) ──
POSTGRES_DB=oracle_staging
POSTGRES_USER=oracle_staging
# Обязателен; сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── приложение ──
# APP_ENV=production (production-like): fail-closed валидация API принимает только
# dev|test|production (app/api/main.py:_validate_production_config), значение "staging"
# она отвергла бы. Требуются BOT_TOKEN, ADMIN_ID, WEBAPP_URL (https), RELEASE_ID,
# miniapp/dist/manifest.json, непустой нешаблонный POSTGRES_PASSWORD. Изоляция
# staging от прода — инфраструктурная (отдельный compose-проект/сети/порты/секреты),
# а не через APP_ENV.
APP_ENV=production
DEV_MODE=0
# RELEASE_ID — идентификатор релиза, например git SHA. Обязателен.
RELEASE_ID=staging-local

# Staging-бот: ОТДЕЛЬНЫЙ токен от @BotFather (не продовый!).
BOT_TOKEN=
# Числовой id администратора staging (можно тот же личный Telegram id).
ADMIN_ID=

# HTTPS-адрес Mini App для staging-бота (домен staging!). Без него fail-closed
# валидация APP_ENV=staging не пропустит старт API.
WEBAPP_URL=https://localhost:3443
PUBLIC_URL=https://localhost:3443

# ── LLM: на staging по умолчанию офлайн-режим ──
# Продовые LLM-ключи сюда не переносим. LLM_PROVIDER=off — детерминированные
# фолбэки вместо LLM; для репетиции деплоя и отката этого достаточно.
LLM_PROVIDER=off

# ── платежи: Paddle SANDBOX (BUS-134) ──
# Только sandbox-значения! Продовые платёжные секреты сюда переносить ЗАПРЕЩЕНО
# (правило изоляции в шапке файла). Sandbox-ключ получает board/user в Paddle
# Dashboard (sandbox-аккаунт, sandbox-login.paddle.com): Developer tools >
# Authentication > API keys > New API key. Формат ключа: 69 символов, префикс
# pdl_..., содержит apikey_ и sdbx_ (sdbx_ = sandbox, live_ = прод — такой
# ключ сюда вставлять нельзя). Sandbox-ключи работают только против
# https://sandbox-api.paddle.com — это и есть проверка изоляции.
# PADDLE_WEBHOOK_SECRET — секрет вебхука из sandbox-аккаунта: Developer tools >
# Notifications > New destination > Webhook, адрес: https://<STAGING_DOMAIN>/
# api/webhooks/paddle, секрет выдаётся при создании (pdl_ntfset_...).
# PADDLE_CHECKOUT_URL — дефолтный sandbox-checkout домен аккаунта (Paddle
# Dashboard: Checkout > Website approval; для sandbox домен уже одобрен по
# умолчанию). Формат: https://<default-sandbox-checkout-domain>.
# PADDLE_PRICE_IDS — тарифы из sandbox-каталога, формат `vip:pri_...,basic:pri_...`
# (products > prices; создаются заранее в sandbox-каталоге).
# Проверка сверки с продом: infra/staging/check_staging_isolation.sh (пункт 5).
PADDLE_API_URL=https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=
PADDLE_PRICE_IDS=

# ── база ──
# ВАЖНО: пароль в DATABASE_URL должен совпадать с POSTGRES_PASSWORD выше —
# их рассинхрон даёт InvalidPasswordError уже на этапе миграций (урок BUS-105).
DATABASE_URL=postgresql+asyncpg://oracle_staging:CHANGE_ME_same_as_POSTGRES_PASSWORD@staging-postgres:5432/oracle_staging
PG_POOL_SIZE=5
PG_MAX_OVERFLOW=5

# ── логирование ──
LOG_LEVEL=INFO
